# ADK Environment Configuration
# Option 1: Use Google Cloud Vertex AI (Application Default Credentials)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option 2: Or use a Gemini API Key from Google AI Studio (uncomment below and set GOOGLE_GENAI_USE_VERTEXAI=FALSE)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your_api_key_here
