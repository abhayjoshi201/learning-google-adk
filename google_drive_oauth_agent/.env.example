# ADK Environment Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: OAuth 2.0 Client Credentials for Local ADK Web UI Consent Pop-up
# (In Production Gemini Enterprise, these are NOT needed—Gemini Enterprise injects `temp:google-drive-auth`)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
AUTH_ID=google-drive-auth
